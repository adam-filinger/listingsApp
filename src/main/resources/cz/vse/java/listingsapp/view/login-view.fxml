<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml"
            fx:controller="cz.vse.java.listingsapp.controller.login.LoginController">
    <bottom>
        <VBox spacing="10" alignment="CENTER">
            <Button text="Login" onAction="#login"/>
            <Button text="Go to Sign Up" onAction="#goToSignUp"/>
        </VBox>
    </bottom>
</BorderPane>