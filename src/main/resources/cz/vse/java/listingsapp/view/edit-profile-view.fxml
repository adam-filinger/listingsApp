<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<VBox xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cz.vse.java.listingsapp.controller.offerControllers.EditProfileController"
      spacing="15" style="-fx-background-color: #FAFAFA; -fx-padding: 20;">
    <Label text="Edit Profile">
        <font>
            <Font name="System Bold" size="24.0"/>
        </font>
    </Label>
    <VBox spacing="5">
        <Label text="Name:"/>
        <TextField fx:id="nameField"/>
    </VBox>
    <VBox spacing="5">
        <Label text="Email:"/>
        <TextField fx:id="emailField"/>
    </VBox>
    <VBox fx:id="businessFields" spacing="15" visible="false">
        <VBox spacing="5">
            <Label text="Company Name:"/>
            <TextField fx:id="companyNameField"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Company Email:"/>
            <TextField fx:id="companyEmailField"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Phone Number:"/>
            <TextField fx:id="phoneField"/>
        </VBox>
    </VBox>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button  onAction="#handleUpdateProfile" text="Update Profile" style="-fx-base: #4CAF50;"/>
        <Button fx:id="deleteBussBtn" onAction="#deleteBusiness" visible="false" text="Delete Business" style="-fx-base: #ffb11b;"/>
        <Button  onAction="#deleteAccount" text="Delete Account"  style="-fx-base: #f44336;"/>
    </HBox>
</VBox>
